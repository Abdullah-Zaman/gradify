# Copy to backend/.env and fill in. Never commit the real .env.

# PostgreSQL connection. URL-encode special characters in the password.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/gradify"

# JWT secrets: random, at least 32 characters, different from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Allowed browser origin(s) for CORS, comma-separated, no trailing slash.
# Local: http://localhost:3000   Production: https://your-domain.com
FRONTEND_URL=http://localhost:3000
PORT=4000

# Number of reverse-proxy hops in front of the backend (nginx = 1).
# TRUST_PROXY=1

# Accounts created by `npm run db:setup` (only if they do not exist yet).
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=

# Optional: GitHub personal access token for commit tracking.
GITHUB_TOKEN=
