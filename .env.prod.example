# Copy to .env.prod on the server (never commit it) and fill in every value.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod ...

# Database. Use a long letters+digits password (it is embedded in a URL).
#   Generate: openssl rand -hex 24
POSTGRES_USER=gradify
POSTGRES_PASSWORD=
POSTGRES_DB=gradify

# JWT secrets: two different random values.
#   Generate each with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# Public URLs (replace your-domain.com, no trailing slash).
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# Reverse-proxy hops in front of the backend (host nginx = 1).
TRUST_PROXY=1

# Accounts created by `npm run db:setup` on first deploy.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
MANAGER_EMAIL=
MANAGER_PASSWORD=

# Optional: GitHub token for commit tracking.
GITHUB_TOKEN=
